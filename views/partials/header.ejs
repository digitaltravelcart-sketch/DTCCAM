<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Travel CAM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark tc-navbar">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">Travel CAM</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/leads">Leads / CRM</a></li>
        <li class="nav-item"><a class="nav-link" href="/quotations">Quotations</a></li>
        <li class="nav-item"><a class="nav-link" href="/bookings">Bookings</a></li>
        <li class="nav-item"><a class="nav-link" href="/hotels">Hotel Contracts</a></li>
        <% if (['Super Admin','Director'].includes(currentRole)) { %>
        <li class="nav-item"><a class="nav-link" href="/admin/users">Admin: Users</a></li>
        <% } %>
      </ul>
      <span class="navbar-text text-light me-3">
        <%= currentUser.full_name %> <span class="badge bg-light text-dark"><%= currentRole %></span>
      </span>
      <form action="/logout" method="POST" class="d-inline">
        <button class="btn btn-outline-light btn-sm">Log out</button>
      </form>
    </div>
  </div>
</nav>
<% } %>
<div class="container-fluid px-4 py-4">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
