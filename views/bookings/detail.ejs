<%- include('../partials/header', {title: booking.booking_code}) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4 class="mb-0"><%= booking.booking_code %> — <%= booking.destination %></h4>
    <small class="text-muted">
      Travel: <%= booking.travel_start_date %> · <%= booking.pax_adults %> adult(s), <%= booking.pax_children %> child(ren) ·
      <span class="badge bg-info text-dark"><%= booking.status.replace(/_/g,' ') %></span>
    </small>
  </div>
  <% if (booking.status !== 'cancelled') { %>
  <form method="POST" action="/bookings/<%= booking.id %>/cancel" onsubmit="return confirm('Cancel this booking?');">
    <button class="btn btn-outline-danger btn-sm">Cancel Booking</button>
  </form>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card p-3 mb-3">
      <h6 class="fw-bold">Components</h6>
      <table class="table table-sm align-middle">
        <thead><tr><th>Type</th><th>Description</th><th>Cost</th><th>Status</th><th></th></tr></thead>
        <tbody>
        <% components.forEach(function(c){ %>
          <tr>
            <td><span class="badge bg-secondary text-capitalize"><%= c.component_type %></span></td>
            <td><%= c.description %></td>
            <td>₹<%= Number(c.cost_price).toLocaleString('en-IN') %></td>
            <td>
              <span class="badge bg-<%= c.confirmation_status==='confirmed'?'success':'warning' %>"><%= c.confirmation_status %></span>
            </td>
            <td>
              <% if (canConfirm) { %>
              <form method="POST" action="/bookings/<%= booking.id %>/components/<%= c.id %>/confirm">
                <button class="btn btn-sm btn-outline-primary"><%= c.confirmation_status==='confirmed' ? 'Un-confirm' : 'Confirm' %></button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card p-3">
      <h6 class="fw-bold">Payments</h6>
      <table class="table table-sm mb-2">
        <thead><tr><th>Date</th><th>Amount</th><th>Mode</th></tr></thead>
        <tbody>
        <% payments.forEach(function(p){ %>
          <tr><td><%= (p.received_at||'').slice(0,10) %></td><td>₹<%= Number(p.amount).toLocaleString('en-IN') %></td><td><%= p.payment_mode %></td></tr>
        <% }) %>
        <% if (payments.length===0) { %><tr><td colspan="3" class="text-muted small">No payments recorded yet.</td></tr><% } %>
        </tbody>
      </table>
      <% if (canRecordPayment) { %>
      <form method="POST" action="/bookings/<%= booking.id %>/payments/new" class="row g-2">
        <div class="col-md-4"><input class="form-control form-control-sm" type="number" name="amount" placeholder="Amount ₹" required></div>
        <div class="col-md-4">
          <select class="form-select form-select-sm" name="payment_mode">
            <option>Bank Transfer</option><option>UPI</option><option>Card</option><option>Cash</option>
          </select>
        </div>
        <div class="col-md-4"><button class="btn btn-sm btn-primary w-100">Record Payment</button></div>
      </form>
      <% } %>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card p-3">
      <h6 class="fw-bold">Financials</h6>
      <table class="table table-sm mb-0">
        <tr><td>Sell Price</td><td class="text-end">₹<%= Number(booking.total_sell_price||0).toLocaleString('en-IN') %></td></tr>
        <tr><td>Cost Price</td><td class="text-end">₹<%= Number(booking.total_cost_price||0).toLocaleString('en-IN') %></td></tr>
        <tr class="text-success"><td>Gross Margin</td><td class="text-end">₹<%= Number(booking.gross_margin||0).toLocaleString('en-IN') %></td></tr>
        <tr><td>Paid so far</td><td class="text-end">₹<%= Number(paid).toLocaleString('en-IN') %></td></tr>
        <tr class="fw-bold"><td>Outstanding</td><td class="text-end">₹<%= Number(outstanding).toLocaleString('en-IN') %></td></tr>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
