<%- include('../partials/header', {title: 'Quotations'}) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="section-title mb-0">Quotations</h4>
  <a href="/quotations/new" class="btn btn-primary btn-sm">+ New Quotation</a>
</div>

<div class="card p-3">
<table class="table table-hover align-middle">
  <thead>
    <tr><th>#</th><th>Destination</th><th>Lead</th><th>Cost</th><th>Sell Price</th><th>Margin %</th><th>Status</th></tr>
  </thead>
  <tbody>
    <% quotations.forEach(function(q){ %>
    <tr>
      <td><a href="/quotations/<%= q.id %>">QUO-<%= q.id %></a></td>
      <td><%= q.destination %></td>
      <td><%= q.lead_id ? (store.find('leads', q.lead_id)||{}).guest_name : '—' %></td>
      <td>₹<%= Number(q.total_cost||0).toLocaleString('en-IN') %></td>
      <td>₹<%= Number(q.total_sell_price||0).toLocaleString('en-IN') %></td>
      <td><%= Number(q.margin_pct||0).toFixed(1) %>%</td>
      <td><span class="badge bg-info text-dark"><%= q.status %></span></td>
    </tr>
    <% }) %>
    <% if (quotations.length===0) { %>
      <tr><td colspan="7" class="text-muted text-center py-4">No quotations yet.</td></tr>
    <% } %>
  </tbody>
</table>
</div>

<%- include('../partials/footer') %>
