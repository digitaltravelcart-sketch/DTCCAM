<%- include('../partials/header', {title: 'Admin: Users'}) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="section-title mb-0">Admin: Users & Roles</h4>
  <a href="/admin/users/new" class="btn btn-primary btn-sm">+ New User</a>
</div>

<div class="card p-3">
<table class="table table-hover align-middle">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% users.forEach(function(u){ %>
    <tr>
      <td><%= u.full_name %> <% if (u.id === currentUser.id) { %><span class="badge bg-light text-dark">you</span><% } %></td>
      <td><%= u.email %></td>
      <td>
        <form method="POST" action="/admin/users/<%= u.id %>/role" class="d-flex gap-1">
          <select name="role_id" class="form-select form-select-sm" onchange="this.form.submit()">
            <% roles.forEach(function(r){ %>
              <option value="<%= r.id %>" <%= u.role_id===r.id?'selected':'' %>><%= r.name %></option>
            <% }) %>
          </select>
        </form>
      </td>
      <td><span class="badge bg-<%= u.status==='active'?'success':'secondary' %>"><%= u.status %></span></td>
      <td>
        <% if (u.id !== currentUser.id) { %>
        <form method="POST" action="/admin/users/<%= u.id %>/toggle-status">
          <button class="btn btn-sm btn-outline-secondary"><%= u.status==='active' ? 'Deactivate' : 'Activate' %></button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>

<%- include('../partials/footer') %>
