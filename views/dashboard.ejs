<%- include('partials/header', {title: 'Dashboard'}) %>

<h4 class="section-title">Welcome back, <%= currentUser.full_name %></h4>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-2">
    <div class="card card-kpi p-3">
      <div class="kpi-label">Today's Enquiries</div>
      <div class="kpi-value"><%= todaysEnquiries %></div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card card-kpi p-3">
      <div class="kpi-label">Pending Quotations</div>
      <div class="kpi-value"><%= pendingQuotations %></div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card card-kpi p-3">
      <div class="kpi-label">Hotel Confirm Pending</div>
      <div class="kpi-value"><%= pendingHotelConfirmations %></div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card card-kpi p-3">
      <div class="kpi-label">Travelling Today</div>
      <div class="kpi-value"><%= travellingToday %></div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card card-kpi p-3">
      <div class="kpi-label">Payments Pending</div>
      <div class="kpi-value">₹<%= paymentsPending.toLocaleString('en-IN') %></div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card card-kpi p-3">
      <div class="kpi-label">Profit (MTD)</div>
      <div class="kpi-value">₹<%= profitMTD.toLocaleString('en-IN') %></div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-4">
    <div class="card p-3 h-100">
      <h6 class="fw-bold mb-3">Sales Leaderboard</h6>
      <% if (leaderboardArr.length === 0) { %>
        <p class="text-muted small">No bookings yet.</p>
      <% } %>
      <ol class="mb-0">
        <% leaderboardArr.forEach(function(row){ %>
          <li><%= row[0] %> — ₹<%= row[1].toLocaleString('en-IN') %></li>
        <% }) %>
      </ol>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card p-3 h-100">
      <h6 class="fw-bold mb-3">Destination-wise Revenue</h6>
      <% if (destArr.length === 0) { %>
        <p class="text-muted small">No bookings yet.</p>
      <% } %>
      <ul class="list-unstyled mb-0">
        <% destArr.forEach(function(row){ %>
          <li><%= row[0] %> — ₹<%= row[1].toLocaleString('en-IN') %></li>
        <% }) %>
      </ul>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card p-3 h-100">
      <h6 class="fw-bold mb-3">Upcoming Departures</h6>
      <% if (upcoming.length === 0) { %>
        <p class="text-muted small">No upcoming bookings.</p>
      <% } %>
      <ul class="list-unstyled mb-0">
        <% upcoming.forEach(function(b){ %>
          <li>
            <a href="/bookings/<%= b.id %>"><%= b.booking_code %></a>
            — <%= b.destination %> (<%= b.travel_start_date %>)
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<div class="mt-4">
  <a href="/leads/new" class="btn btn-primary btn-sm">+ New Lead</a>
  <a href="/quotations/new" class="btn btn-outline-primary btn-sm">+ New Quotation</a>
  <a href="/hotels/new" class="btn btn-outline-secondary btn-sm">+ New Hotel</a>
</div>

<%- include('partials/footer') %>
