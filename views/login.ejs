<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Log in · Travel CAM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body style="background:#1f4e78;">
  <div class="login-wrapper">
    <div class="card login-card p-4">
      <h3 class="text-center mb-1" style="color:#1f4e78; font-weight:700;">Travel CAM</h3>
      <p class="text-center text-muted mb-4">Digital Travel Cart Pvt Ltd</p>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>
      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <button class="btn btn-primary w-100" type="submit">Log in</button>
      </form>
      <p class="text-center text-muted mt-3 mb-0" style="font-size:0.8rem;">
        First time? Default login: admin@digitaltravelcart.com / admin123
      </p>
    </div>
  </div>
</body>
</html>
