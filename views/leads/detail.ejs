<%- include('../partials/header', {title: lead.guest_name}) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4 class="mb-0"><%= lead.guest_name %> — <%= lead.destination %></h4>
    <small class="text-muted"><%= lead.phone %> · <%= lead.email %> · Source: <%= lead.source %></small>
  </div>
  <a href="/quotations/new?lead_id=<%= lead.id %>" class="btn btn-primary btn-sm">+ Create Quotation</a>
</div>

<div class="row g-3">
  <div class="col-md-4">
    <div class="card p-3">
      <h6 class="fw-bold">Status & Ownership</h6>
      <form method="POST" action="/leads/<%= lead.id %>/update">
        <div class="mb-2">
          <label class="form-label small">Status</label>
          <select class="form-select form-select-sm" name="status">
            <% ['new','contacted','quoted','negotiation','won','lost'].forEach(function(s){ %>
              <option value="<%= s %>" <%= lead.status===s?'selected':'' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small">Priority</label>
          <select class="form-select form-select-sm" name="priority">
            <% ['low','medium','high'].forEach(function(p){ %>
              <option value="<%= p %>" <%= lead.priority===p?'selected':'' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small">Assigned To</label>
          <select class="form-select form-select-sm" name="assigned_to">
            <option value="">Unassigned</option>
            <% users.forEach(function(u){ %>
              <option value="<%= u.id %>" <%= lead.assigned_to===u.id?'selected':'' %>><%= u.full_name %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-sm btn-outline-primary w-100">Save</button>
      </form>
    </div>
    <div class="card p-3 mt-3">
      <h6 class="fw-bold">Trip Info</h6>
      <p class="mb-1 small">Travel start: <%= lead.travel_start_date || '—' %></p>
      <p class="mb-1 small">Pax: <%= lead.pax_adults %> adults, <%= lead.pax_children %> children<% if (lead.pax_children_ages && lead.pax_children_ages.length) { %> (ages: <%= lead.pax_children_ages.join(', ') %>)<% } %></p>
      <p class="mb-0 small">Budget/pax: ₹<%= lead.budget_per_pax || '—' %></p>
    </div>
    <div class="card p-3 mt-3">
      <h6 class="fw-bold">Quotations</h6>
      <% if (quotations.length===0) { %><p class="text-muted small mb-0">None yet.</p><% } %>
      <ul class="list-unstyled mb-0">
        <% quotations.forEach(function(q){ %>
          <li><a href="/quotations/<%= q.id %>">QUO-<%= q.id %></a> — <span class="badge bg-info text-dark"><%= q.status %></span></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="col-md-8">
    <div class="card p-3">
      <h6 class="fw-bold">Notes & Call Log</h6>
      <form method="POST" action="/leads/<%= lead.id %>/note" class="mb-3">
        <div class="input-group">
          <input class="form-control" name="note" placeholder="Log a call, note, or follow-up..." required>
          <button class="btn btn-primary">Add</button>
        </div>
      </form>
      <ul class="list-unstyled">
        <% notes.forEach(function(n){ %>
          <li class="border-bottom py-2">
            <small class="text-muted"><%= (n.created_at||'').replace('T',' ').slice(0,16) %> — <%= (store.find('users', n.created_by)||{}).full_name || 'System' %></small>
            <div><%= n.note %></div>
          </li>
        <% }) %>
        <% if (notes.length===0) { %><li class="text-muted small">No notes yet.</li><% } %>
      </ul>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
