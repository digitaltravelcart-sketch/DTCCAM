<%- include('partials/header', {title: 'Account Recovery'}) %>

<div class="card p-4" style="max-width:480px; margin: 40px auto;">
  <h4 class="mb-3">Account Recovery</h4>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (!success) { %>
  <form method="POST" action="/recover-admin">
    <div class="mb-3">
      <label class="form-label">Recovery Token</label>
      <input class="form-control" name="token" required>
      <div class="form-text">The value you set as RECOVERY_TOKEN in your host's environment variables.</div>
    </div>
    <div class="mb-3">
      <label class="form-label">Account Email to Restore</label>
      <input class="form-control" type="email" name="email" required>
      <div class="form-text">This account will be set to Super Admin and active.</div>
    </div>
    <button class="btn btn-primary">Restore Account</button>
  </form>
  <% } %>
</div>

<%- include('partials/footer') %>
